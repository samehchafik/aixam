{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIXAM EASY",
  "version": "0.1.0",
  "identifier": "com.aixam.easy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "touch",
        "title": "AIXAM EASY",
        "fullscreen": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "resources": ["config.json"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/128x128.png"]
  }
}
