.env
# Le lanceur engendre depuis Reglages > Ecrans porte des valeurs d'INSTALLATION
# -- les ecrans de CETTE borne, leurs coordonnees -- pas du code. Il se
# regenere, il ne se versionne pas.
demarrage/*
!demarrage/start.bat
!demarrage/stop.bat
!demarrage/stop-clavier.bat
!demarrage/borne-start.bat
# Les copies de travail d'un .env portent les memes secrets que lui : une
# sauvegarde avant manipulation ne doit pas se retrouver a portee de `git add`.
.env.*
!.env.example
node_modules/
dist/
__pycache__/
*.pyc
.venv/
apps/api/static/
# Les creations des visiteurs sont des donnees du salon, pas du code : elles ne
# sont pas versionnees. Le DOSSIER, lui, doit exister des le clone -- docker le
# monte a un chemin fixe, et le creerait sinon en root.
apps/api/media/renders/*
!apps/api/media/renders/.gitkeep
apps/api/media/relay/*
!apps/api/media/relay/.gitkeep
apps/kiosk/src-tauri/target/
.DS_Store
tsconfig.tsbuildinfo
.venv/
# Worktrees des sessions Claude Code : des depots a part, jamais du contenu.
.claude/worktrees/

# Temoin de la derniere construction de l'image API : local a la machine.
.api-image-built

# Pid et journaux des processus lances par bin/start.sh --local.
.run/

# Releve des ecrans : propre a la machine qui l'a produit.
materiels.json

# Le gitignore global de ce poste (~/.gitignore_global) exclut « README.md »
# et « .gitignore » par des motifs nus, heritage d'un autre projet. Sans ces
# deux exceptions, la doc de deploy/ et ce fichier meme n'entrent jamais dans
# le depot -- et un clone sur le serveur se retrouve sans aucune regle
# d'exclusion. Les regles du depot l'emportent sur le gitignore global.
!.gitignore
!README.md
apps/borne/target/
