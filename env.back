# Poste de dev : API et worker sur la machine, base PostgreSQL locale,
# emails confies au back-office serveur. Seul ce qui differe des defauts
# du code figure ici -- .env.example garde la reference complete.

# --- Base locale ---
# POSTGRES_HOST vaut deja localhost par defaut. Sous docker, compose le
# remplace par « db » ; decommenter alors COMPOSE_PROFILES pour demarrer
# la base en conteneur.
POSTGRES_USER=aixam
POSTGRES_PASSWORD=EdU8Ad6R1jsF/2QxVyL8EYqRZUe
POSTGRES_DB=aixam

# --- Acces au back-office ---
# Surtout pas un domaine en .local : reserve, refuse a la connexion.
ADMIN_EMAIL=admin@ifrit.fr
ADMIN_PASSWORD=EdU8Ad6F+2xVyL8EYqRZUe
SECRET_KEY=_ybMcxcPFj2yCZw2tIfjYkj9QGRaqwEozPKwgQQvAPtq94rQdBUGPfh7ycREzgq3

# --- Emails : on n'expedie pas d'ici, le serveur s'en charge ---
MAIL_TRANSPORT=relay
MAIL_RELAY_URL=https://aixam-admin.ifrit.fr

# Reglages > Clients de relais sur aixam-admin.ifrit.fr. Affiche une seule fois.
MAIL_RELAY_TOKEN=axr_fe112e29522f_XD_ZosFUTJVfWnFGjaYrAFX6nRdeSXbMOej_eOkhOe4
