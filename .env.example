# --- Base ---
# Ou tourne PostgreSQL. Les trois variables ci-dessous servent dans les deux
# cas ; seul l'hote change.
#
# En conteneur (defaut, celui du stand) : garder COMPOSE_PROFILES, ne pas
# toucher a POSTGRES_HOST.
#
# Sur le PostgreSQL de la machine : commenter COMPOSE_PROFILES et decommenter
# POSTGRES_HOST. Voir deploy/README.md pour le role, pg_hba, listen_addresses.
#
# La valeur est la passerelle du reseau, soit la premiere adresse de
# DOCKER_SUBNET. On la donne en clair plutot que host.docker.internal : ce nom
# est resolu vers l'adresse du pont PAR DEFAUT (172.17.0.1), qui n'est pas
# celle de notre reseau -- un ecart de plus a diagnostiquer pour rien.
COMPOSE_PROFILES=container-db
# POSTGRES_HOST=10.83.0.1
#
# DATABASE_URL n'est utile que pour un cas particulier -- base distante,
# socket, options SSL. Renseignee, elle l'emporte sur les variables POSTGRES_*.
# Attention : c'est alors a vous d'encoder / @ : ? dans le mot de passe.
# DATABASE_URL=
POSTGRES_USER=aixam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aixam
API_PORT=8080

# Interface sur laquelle le port de l'API est publie. Derriere un reverse
# proxy, mettre 127.0.0.1 : sans ca l'API reste joignable en direct sur le
# 8080, donc en clair et hors nginx. Sur le stand, laisser 0.0.0.0 -- la
# borne joint l'API par le reseau local.
API_BIND=0.0.0.0

# Plage reseau des conteneurs. Figee pour que la passerelle soit stable :
# c'est par elle que l'API joint un PostgreSQL installe sur la machine, et
# elle doit figurer dans listen_addresses et pg_hba.conf. La passerelle est
# la premiere adresse de la plage -- 10.83.0.1 pour la valeur ci-dessous.
#
# Volontairement hors de 172.17-172.31 : c'est la ou docker pioche quand il
# attribue un reseau tout seul, donc un projet cree plus tard pourrait tomber
# sur la notre. Verifier quand meme que la plage ne sert pas sur le reseau de
# la machine : `ip route`.
#
# Si docker refuse le reseau (« Pool overlaps with other one on this address
# space »), la plage est deja prise : en choisir une autre. Pour voir ce qui
# est occupe :
#   docker network ls -q | xargs -r docker network inspect \
#     -f '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}'
DOCKER_SUBNET=10.83.0.0/16

# --- Securite ---
# Cle de signature des jetons d'administration. La valeur ci-dessous est
# PUBLIQUE (elle est dans ce fichier, sur GitHub) : la laisser telle quelle
# revient a permettre a quiconque de se forger un jeton admin. En generer une :
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-32-chars-minimum-please

# Un domaine reel. Surtout pas .local, .test ni .invalid : ce sont des noms
# reserves, refuses par la validation d'email -- le compte serait cree au
# demarrage mais la connexion au back-office repondrait 422.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Protege le lien https de dev de la borne (HTTP Basic sur /kiosk).
# Laisser vide en production salon (la borne est en local).
KIOSK_BASIC_USER=aixam
KIOSK_BASIC_PASSWORD=salon2026

# Token que la borne presente a l'API. Un par borne, cree depuis l'admin.
# Celui-ci est cree au bootstrap pour demarrer -- il est public comme le
# reste de ce fichier, donc a remplacer des que le serveur est expose.
DEFAULT_KIOSK_TOKEN=dev-kiosk-token

# --- Email : par ou sortent les messages ---
# smtp  : boite OVH ou relais SMTP de Brevo. Demande que le port SMTP sorte.
# brevo : API HTTP de Brevo, en 443. A choisir si le reseau du salon filtre
#         le 587 -- ce qui arrive plus souvent qu'on ne le voudrait.
# relay : on n'expedie pas d'ici, on confie les emails a un autre back-office
#         AIXAM (voir plus bas). Le reglage se change aussi a chaud depuis
#         Reglages > Envoi des emails, sans redemarrer le conteneur.
MAIL_TRANSPORT=smtp

# Expediteur, dans les trois cas. C'est le serveur qui l'impose : un client de
# relais ne peut pas ecrire au nom de quelqu'un d'autre.
# ATTENTION, c'est ici que se joue la delivrabilite : le domaine de MAIL_FROM
# doit etre celui que la connexion SMTP authentifie, sinon SPF et DKIM signent
# pour un autre domaine que celui affiche. Un domaine qui publie un DMARC en
# p=reject fait alors REJETER l'email -- pas classer en spam. Verifier :
#   dig +short TXT _dmarc.<domaine>
#   dig +short TXT <domaine> | grep spf
MAIL_FROM=noreply@exemple.fr
MAIL_FROM_NAME=AIXAM

# Une adresse a laquelle un visiteur peut vraiment repondre. Un expediteur
# muet pese dans le classement en indesirable.
MAIL_REPLY_TO=

# --- SMTP ---
# OVH   : SMTP_HOST=ssl0.ovh.net, port 587 (STARTTLS) ou 465 (SSL direct),
#         SMTP_USER = l'adresse complete de la boite.
# Brevo : SMTP_HOST=smtp-relay.brevo.com, port 587, identifiant du compte en
#         SMTP_USER et une cle SMTP en SMTP_PASSWORD.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Laisser false : le 465 bascule tout seul en SSL direct.
SMTP_SSL=false

# --- Brevo, API HTTP (MAIL_TRANSPORT=brevo) ---
BREVO_API_KEY=

# --- Relais, cote client : le back-office du stand (MAIL_TRANSPORT=relay) ---
# Le token se genere dans Reglages > Clients de relais du back-office DISTANT,
# ou il n'est affiche qu'une fois. Renseignable aussi depuis l'admin locale.
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
MAIL_RELAY_TIMEOUT_SECONDS=30
# Le http:// est refuse hors localhost : le token transiterait en clair sur le
# reseau du salon. A ne lever que si le lien est deja protege (VPN, LAN prive).
MAIL_RELAY_ALLOW_INSECURE=false

# --- Relais, cote serveur : le back-office qui expedie pour les autres ---
# Ouvre /api/relay/*. Volontairement hors des reglages a chaud : accepter de
# poster pour autrui est une decision de deploiement, pas une case cochee par
# erreur dans l'admin d'une machine posee sur un stand.
RELAY_SERVER_ENABLED=false
RELAY_DEFAULT_DAILY_QUOTA=2000
RELAY_RATE_LIMIT_PER_MINUTE=120
RELAY_MAX_BODY_BYTES=524288
RELAY_MAX_ATTACHMENT_BYTES=8388608

# --- Remontee des donnees du stand vers le serveur ---
# Cote SERVEUR : accepter les remontees. Distinct du relais d'emails --
# recevoir des visiteurs nominatifs n'est pas poster un message pour autrui.
SYNC_SERVER_ENABLED=false
SYNC_BATCH_SIZE=200

# Cote STAND : ou envoyer. Vides, on reprend l'adresse et le jeton du relais
# d'emails ci-dessus : c'est le meme serveur et le meme client. Reglable aussi
# depuis Reglages > Remontee des donnees.
SYNC_URL=
SYNC_TOKEN=

# Mode degrade : si true, le code de verification est accepte sans email
# (a activer depuis l'admin si le reseau du salon tombe).
ALLOW_VERIFICATION_BYPASS=false

# --- Divers ---
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,tauri://localhost
